# Habblaud de produção no podman (rootless), com o omp do host.
#
# Diferente do Dockerfile da raiz (Alpine, isolado, sem omp): a imagem final é glibc (Debian slim) para rodar o
# binário do omp do host, que o Habblaud chama para o uso dos provedores (`omp usage --json`). Quem monta as pastas
# e liga a rede do host é o quadlet ao lado (habblaud.container).
#
# Construir (na raiz do repositório):
#   podman build -f deploy/podman/Containerfile -t localhost/habblaud:producao .
# Atualizar a produção:
#   git pull && podman build -f deploy/podman/Containerfile -t localhost/habblaud:producao . \
#     && systemctl --user restart habblaud

# Base presa pelo digest (node 24.22.1), a mesma nos dois estágios.
FROM docker.io/library/node:24-bookworm-slim@sha256:2dd9a4f758e173b65fee15388f7706af6fb01ef50cf7a2c0538711d67a6981ae AS builder
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY . .
RUN npm run build

FROM docker.io/library/node:24-bookworm-slim@sha256:2dd9a4f758e173b65fee15388f7706af6fb01ef50cf7a2c0538711d67a6981ae
ENV NODE_ENV=production
WORKDIR /app
# O servidor não tem dependências de runtime (só node:*): basta o dist/ e o package.json.
COPY --from=builder /app/package.json ./package.json
COPY --from=builder /app/dist ./dist
CMD ["node", "dist/server/index.js"]
