import { Theme, StatusColors } from "resources.slint";
import { Labels } from "labels.slint";
import { TextField, TextButton, SegmentedControl, Chip, Banner, Avatar, Badge, ScrollList, ScrollContainer, Menu, ProgressRing, Tooltip, Fab } from "widgets/kit.slint";
export struct SessionRow {
    key: string, title: string, subtitle: string, activity: string, time: string, unread: string,
    initials: string, avatar: image, brand: image, brand-color: color, fallback-color: color,
    selected: bool, sub: bool, permission: string,
    working: bool, since: string, activity-text: string,
    avatar-key: string,
}
export struct ServerRow { origin: string, label: string, connection: string, needs-login: bool, error: string }
export global ListState {
    in property <[SessionRow]> rows;
    in property <[ServerRow]> servers;
    in property <string> connection: "connecting";
    in-out property <string> filter;
    in-out property <string> query;
    in-out property <bool> search-open;
    in-out property <int> tab;
    in-out property <bool> menu-open;
    in property <bool> loading;
    in property <bool> app-visible: true;
    in property <bool> terminal-allowed;
    in property <string> terminal-blocked-label;
    in property <bool> cast-visible;
    in property <image> cast-icon;
    callback open(string);
    callback avatar(string);
    callback tick(string);
    callback changed();
    callback settings();
    callback add-server();
    callback relogin(string);
    callback permission(string);
    callback cast();
}
export component ListPane inherits Rectangle {
    background: Theme.background;
    property <int> keyboard-index: -1;
    forward-focus: list-focus;
    init => { list-focus.focus(); }
    list-focus := FocusScope {
        key-pressed(event) => {
            if event.text == Key.DownArrow { root.keyboard-index = min(root.keyboard-index + 1, ListState.rows.length - 1); return accept; }
            if event.text == Key.UpArrow { root.keyboard-index = max(0, root.keyboard-index - 1); return accept; }
            if event.text == Key.Return && root.keyboard-index >= 0 && root.keyboard-index < ListState.rows.length {
                ListState.open(ListState.rows[root.keyboard-index].key); return accept;
            }
            return reject;
        }
    }
    VerticalLayout { padding: 12px; spacing: 8px;
        HorizontalLayout { height: 48px; spacing: 8px;
            Text { text: Labels.app-name; color: Theme.on-surface; font-size: 22px; vertical-alignment: center; horizontal-stretch: 0; }
            Rectangle { width: 10px; height: 10px; border-radius: 5px; background: ListState.connection == "connected" ? Theme.primary : ListState.connection == "connecting" ? StatusColors.warning : Theme.error; accessible-role: text; accessible-label: ListState.connection == "connected" ? Labels.reading-connected : ListState.connection == "connecting" ? Labels.reading-connecting : Labels.reading-offline; }
            Rectangle { horizontal-stretch: 1; }
            TextButton { text: "⋮"; min-width: 40px; clicked => { ListState.menu-open = true; menu.show(); } accessible-label: Labels.menu; }
        }
        for server in ListState.servers: VerticalLayout {
            if server.needs-login: HorizontalLayout { Text { text: server.label; color: Theme.on-surface; vertical-alignment: center; } TextButton { text: Labels.relogin; clicked => { ListState.relogin(server.origin); } } }
            if server.error != "": Text { text: server.error; color: Theme.error; wrap: word-wrap; }
        }
        if ListState.servers.length > 1: ScrollContainer {
            height: 40px;
            content-width: chips.preferred-width;
            chips := HorizontalLayout { spacing: 8px;
                Chip { text: Labels.filter-all; selected: ListState.filter == ""; clicked => { ListState.filter = ""; ListState.changed(); } }
                for server in ListState.servers: Chip {
                    text: "    " + server.label; selected: ListState.filter == server.origin;
                    clicked => { ListState.filter = server.origin; ListState.changed(); }
                    Rectangle { x: 10px; y: (parent.height - 10px) / 2; width: 10px; height: 10px; border-radius: 5px; background: server.needs-login || server.connection == "offline" ? Theme.error : server.connection == "connecting" ? StatusColors.warning : Theme.primary; }
                }
            }
        }
        SegmentedControl { labels: [Labels.open-sessions, Labels.recent-sessions]; selected <=> ListState.tab; chosen(index) => { if ListState.query == "" { ListState.search-open = false; } ListState.changed(); } }
        if ListState.search-open: HorizontalLayout {
            TextField { text <=> ListState.query; placeholder: Labels.search-sessions; autofocus: ListState.query == ""; edited(value) => { ListState.changed(); } }
            TextButton { text: "×"; accessible-label: Labels.search-close; min-width: 40px; clicked => { ListState.query = ""; ListState.search-open = false; ListState.changed(); } }
        }
        if ListState.loading: ProgressRing { height: 24px; }
        if !ListState.loading && !ListState.terminal-allowed: Text { text: ListState.terminal-blocked-label; color: Theme.on-surface-variant; wrap: word-wrap; }
        if !ListState.loading && ListState.rows.length == 0: VerticalLayout { padding: 32px;
            Text { text: ListState.query != "" ? Labels.search-no-match : Labels.sessions-empty; color: Theme.on-surface-variant; wrap: word-wrap; horizontal-alignment: center; }
            if ListState.query != "": TextButton { text: Labels.search-clear; clicked => { ListState.query = ""; ListState.changed(); } }
        }
        session-list := ScrollList {
            for row[index] in ListState.rows: row-box := Rectangle {
                init => { ListState.avatar(row.key); }
                Timer { interval: 1s; running: row.working && ListState.app-visible && root.visible && row-box.y + session-list.content-y + row-box.height > 0px && row-box.y + session-list.content-y < session-list.height; triggered => { ListState.tick(row.key); } }
                height: row.sub ? 36px : max(68px, content.preferred-height + 12px);
                border-radius: 12px; background: row.selected ? Theme.secondary-container : row-touch.pressed ? Theme.on-surface.with-alpha(0.12) : row-touch.has-hover ? Theme.on-surface.with-alpha(0.08) : transparent;
                border-width: root.keyboard-index == index && list-focus.has-focus ? 2px : 0px; border-color: Theme.primary;
                accessible-role: button; accessible-label: row.title + ", " + row.subtitle + (row.activity == "" ? "" : ", " + row.activity) + (row.permission == "" ? "" : ", " + row.permission);
                row-touch := TouchArea { clicked => { root.keyboard-index = index; list-focus.focus(); ListState.open(row.key); } }
                content := HorizontalLayout { padding-top: 6px; padding-bottom: 6px; spacing: 12px;
                    if row.sub: Text { text: "└"; color: Theme.outline-variant; width: 36px; horizontal-alignment: right; }
                    Avatar { width: row.sub ? 24px : 48px; height: self.width; source: row.avatar; initials: row.initials; brand: row.brand; brand-color: row.brand-color; fallback-color: row.fallback-color; }
                    VerticalLayout { spacing: 2px;
                        Tooltip { text: row.title; height: min(title.preferred-height, row.sub ? 20px : 44px);
                            clicked => { root.keyboard-index = index; list-focus.focus(); ListState.open(row.key); }
                            title := Text { text: row.title; color: Theme.on-surface; font-size: row.sub ? 14px : 16px; font-weight: row.unread != "" ? 700 : 500; wrap: word-wrap; overflow: elide; }
                        }
                        Text { text: row.subtitle; color: Theme.on-surface-variant; font-size: row.sub ? 12px : 14px; overflow: elide; font-weight: row.unread != "" ? 700 : 400; }
                        if row.activity != "": Text { text: "✻ " + row.activity; color: Theme.primary; font-size: 12px; overflow: elide; }
                        if row.permission != "": TextButton { text: row.permission; foreground: Theme.error; clicked => { ListState.permission(row.key); } }
                    }
                    if !row.sub: VerticalLayout { alignment: start; spacing: 6px; width: max(32px, time-label.preferred-width);
                        time-label := Text { text: row.time; color: row.unread != "" ? Theme.primary : Theme.on-surface-variant; font-size: 11px; horizontal-alignment: right; }
                        if row.unread != "": Badge { text: row.unread; }
                    }
                }
            }
        }
    }
    // Ponto de montagem do FAB: o recurso de elenco fornece ícone e callback.
    if ListState.cast-visible: Fab { x: parent.width - 72px; y: parent.height - 72px; icon: ListState.cast-icon; label: Labels.cast-start;
        clicked => { ListState.cast(); }
    }
    menu := Menu { x: root.width - 180px; y: 56px; width: 168px;
        TextButton { text: Labels.settings; clicked => { menu.close(); ListState.menu-open = false; ListState.settings(); } }
        TextButton { text: Labels.add-server; clicked => { menu.close(); ListState.menu-open = false; ListState.add-server(); } }
    }
}
