import { Clock } from "clock.slint";
import { Theme, StatusColors } from "resources.slint";
import { Labels } from "labels.slint";
import { TextField, TextButton, SegmentedControl, Chip, Banner, Avatar, Badge, ScrollList, ScrollContainer, Menu, ProgressRing, Tooltip, Fab, IconButton } from "widgets/kit.slint";
import { MaterialIcons } from "widgets/material-icons.slint";
import { FilesState } from "files.slint";
import { CastState } from "cast.slint";
export struct SessionRow {
    key: string, title: string, subtitle: string, activity: string, time: string, unread: string,
    initials: string, avatar: image, brand: image, brand-color: color, fallback-color: color,
    selected: bool, sub: bool, sub-last: bool, permission: string,
    working: bool, since: string, activity-text: string, codex: bool,
    avatar-key: string, unread-label: string,
    pinned: bool, favorite: bool,
}
export struct ServerRow { origin: string, label: string, connection: string, needs-login: bool, error: string }
// Cota de 7 dias de um provedor; severity 0 ok, 1 atenção (≥70%), 2 crítica (≥90% ou esgotada).
export struct QuotaRow { label: string, percent: string, fraction: float, severity: int, resets: string }
export global ListState {
    in property <[SessionRow]> rows;
    in property <[ServerRow]> servers;
    in property <[QuotaRow]> quotas;
    in property <string> quota-title;
    in property <string> connection: "connecting";
    in-out property <string> filter;
    in-out property <string> query;
    in-out property <bool> search-open;
    in-out property <int> tab;
    in-out property <bool> favorites;
    in-out property <bool> menu-open;
    in-out property <int> focus-request;
    in property <bool> loading;
    in property <string> recent-window;
    in property <string> recent-more-label;
    in property <string> recent-more-error;
    in property <bool> recent-more-enabled;
    in property <bool> app-visible: true;
    in property <bool> server-notices;
    in property <bool> terminal-allowed;
    in property <string> terminal-blocked-label;
    in property <bool> cast-visible;
    in property <image> cast-icon;
    in property <[string]> dismissible-keys;
    in property <string> cast-confirmation-key;
    pure callback can-dismiss(string, [string]) -> bool;
    callback dismiss(string);
    callback open(string);
    callback avatar(string);
    callback toggle-pin(string);
    callback toggle-favorite(string);
    callback changed();
    callback load-more-recent();
    callback settings();
    callback add-server();
    callback relogin(string);
    callback permission(string);
    callback cast();
}

// Ações da sessão: clique direito ou menu do teclado na linha, sem coluna de botão.
component SessionActions inherits Rectangle {
    in property <SessionRow> session;
    in property <length> menu-x;
    public function show() { row-menu.show(); }
    row-menu := Menu { x: min(root.menu-x, root.width - self.width); y: 40px; width: 220px;
        TextButton { text: root.session.pinned ? Labels.unpin-session : Labels.pin-session; horizontal-alignment: left; clicked => { row-menu.close(); ListState.toggle-pin(root.session.key); } }
        TextButton { text: root.session.favorite ? Labels.unfavorite-session : Labels.favorite-session; horizontal-alignment: left; clicked => { row-menu.close(); ListState.toggle-favorite(root.session.key); } }
        if ListState.can-dismiss(root.session.key, ListState.dismissible-keys): TextButton {
            text: CastState.dismiss-label; horizontal-alignment: left; enabled: CastState.enabled;
            clicked => { row-menu.close(); ListState.dismiss(root.session.key); }
        }
    }
}

export component ListPane inherits Rectangle {
    body-metrics := Text { visible: false; text: "M"; font-size: 16px; }
    subtitle-metrics := Text { visible: false; text: "M"; font-size: 14px; }
    background: Theme.background;
    property <int> keyboard-index: -1;
    // Menu da linha pelo teclado (tecla Menu ou Shift+F10): sobe o contador e a linha em foco abre as ações.
    property <int> menu-request: 0;
    forward-focus: list-focus;
    private property <int> focus-request: ListState.focus-request;
    changed focus-request => { list-focus.focus(); }
    private property <bool> search-open: ListState.search-open;
    changed search-open => { if !self.search-open { list-focus.focus(); } }
    changed visible => { Clock.viewport(session-list.content-y, session-list.height, self.visible); }
    init => { list-focus.focus(); }
    private property <int> session-count: ListState.rows.length - (ListState.rows.length > 0 && ListState.rows[ListState.rows.length - 1].key == "" ? 1 : 0);
    list-focus := FocusScope {
        key-pressed(event) => {
            if event.text == Key.DownArrow {
                root.keyboard-index = min(root.keyboard-index + 1, ListState.rows.length - 1);
                session-list.ensure-row-visible(root.keyboard-index, ScrollBehavior.instant);
                return accept;
            }
            if event.text == Key.UpArrow {
                root.keyboard-index = max(0, root.keyboard-index - 1);
                session-list.ensure-row-visible(root.keyboard-index, ScrollBehavior.instant);
                return accept;
            }
            if event.text == Key.Return && root.keyboard-index >= 0 && root.keyboard-index < ListState.rows.length {
                let key = ListState.rows[root.keyboard-index].key;
                if key != "" { ListState.open(key); }
                else if ListState.recent-more-enabled { ListState.load-more-recent(); }
                return accept;
            }
            if (event.text == Key.Menu || (event.text == Key.F10 && event.modifiers.shift)) && root.keyboard-index >= 0 && root.keyboard-index < ListState.rows.length && ListState.rows[root.keyboard-index].key != "" && !ListState.rows[root.keyboard-index].sub {
                root.menu-request += 1; return accept;
            }
            return reject;
        }
    }
    Rectangle { x: 0px; y: 0px; width: root.width; height: 64px; background: Theme.surface; }
    VerticalLayout { spacing: 0px;
        HorizontalLayout { height: 64px; spacing: 8px; padding-left: 16px; padding-right: 12px;
            Text { text: Labels.app-name; color: Theme.on-surface; font-size: 22px; vertical-alignment: center; horizontal-stretch: 0; }
            Rectangle { width: 10px;
                Rectangle { y: (parent.height - self.height) / 2; width: 10px; height: 10px; border-radius: 5px; background: ListState.connection == "connected" ? Theme.primary : ListState.connection == "connecting" ? StatusColors.warning : Theme.error; accessible-role: text; accessible-label: ListState.connection == "connected" ? Labels.reading-connected : ListState.connection == "connecting" ? Labels.reading-connecting : Labels.reading-offline; }
            }
            Rectangle { horizontal-stretch: 1; }
            // Desktop não tem a puxada do Android: a busca abre por este botão ou Ctrl/Cmd+F.
            VerticalLayout { width: 32px; alignment: center; IconButton { width: 32px; icon: MaterialIcons.search; label: Labels.search-sessions; clicked => { ListState.search-open = !ListState.search-open; if !ListState.search-open { ListState.query = ""; ListState.changed(); } } } }
            VerticalLayout { width: 32px; alignment: center; IconButton { width: 32px; icon: MaterialIcons.more-vert; label: Labels.menu; clicked => { ListState.menu-open = true; menu.show(); } } }
        }
        VerticalLayout { padding-left: 12px; padding-right: 12px; spacing: 8px;
        if ListState.server-notices: VerticalLayout { spacing: 8px;
            for server in ListState.servers: VerticalLayout { spacing: 8px;
                if server.needs-login: HorizontalLayout { height: 48px; Text { text: server.label; color: Theme.on-surface; vertical-alignment: center; } VerticalLayout { width: relogin-action.min-width; alignment: center; relogin-action := TextButton { text: Labels.relogin; clicked => { ListState.relogin(server.origin); } } } }
                if server.error != "": Text { text: server.error; color: Theme.error; wrap: word-wrap; }
            }
        }
        if ListState.servers.length > 1: ScrollContainer {
            height: 48px;
            content-width: chips.preferred-width;
            chips := HorizontalLayout { spacing: 8px;
                Chip { text: Labels.filter-all; selected: ListState.filter == ""; clicked => { ListState.filter = ""; ListState.changed(); } }
                for server in ListState.servers: Chip {
                    text: "    " + server.label; selected: ListState.filter == server.origin;
                    clicked => { ListState.filter = server.origin; ListState.changed(); }
                    Rectangle { x: 10px; y: (parent.height - 10px) / 2; width: 10px; height: 10px; border-radius: 5px; background: server.needs-login || server.connection == "offline" ? Theme.error : server.connection == "connecting" ? StatusColors.warning : Theme.primary; }
                }
            }
        }
        Rectangle { height: 48px; SegmentedControl { x: 0px; y: 4px; width: parent.width; height: 40px; labels: [Labels.open-sessions, Labels.recent-sessions]; selected <=> ListState.tab; chosen(index) => { if ListState.query == "" { ListState.search-open = false; } ListState.changed(); } } }
        HorizontalLayout { height: 40px; spacing: 8px;
            Chip { text: Labels.filter-all; selected: !ListState.favorites; clicked => { ListState.favorites = false; ListState.changed(); } }
            Chip { text: Labels.favorite-sessions; selected: ListState.favorites; clicked => { ListState.favorites = true; ListState.changed(); } }
            Rectangle { horizontal-stretch: 1; }
        }
        if ListState.search-open: TextField {
            text <=> ListState.query; placeholder: Labels.search-sessions; autofocus: ListState.query == "";
            leading-icon: MaterialIcons.search; trailing-icon: MaterialIcons.close; trailing-label: Labels.search-close;
            edited(value) => { ListState.changed(); }
            trailing-clicked => { ListState.query = ""; ListState.search-open = false; ListState.changed(); }
        }
        if ListState.loading: ProgressRing { height: 24px; }
        if !ListState.loading && !ListState.terminal-allowed: Text { text: ListState.terminal-blocked-label; color: Theme.on-surface; font-size: 16px; letter-spacing: 0.5px; line-height-factor: 24px / body-metrics.preferred-height; wrap: word-wrap; }
        if !ListState.loading && root.session-count == 0: VerticalLayout { padding: 32px;
            Text { text: ListState.query != "" ? Labels.search-no-match : Labels.sessions-empty; color: Theme.on-surface-variant; wrap: word-wrap; horizontal-alignment: center; }
            if ListState.query != "": TextButton { text: Labels.search-clear; clicked => { ListState.query = ""; ListState.changed(); } }
        }
        session-list := ScrollList {
            changed content-y => { Clock.viewport(self.content-y, self.height, root.visible); }
            changed height => { Clock.viewport(self.content-y, self.height, root.visible); }
            for row[index] in ListState.rows: row-box := Rectangle {
                property <bool> footer: row.key == "";
                property <length> body-height: self.footer ? footer-content.preferred-height : row.sub ? 36px : max(60px, content.preferred-height);
                property <length> group-spacing: index + 1 < root.session-count && (row.sub ? row.sub-last : !ListState.rows[index + 1].sub) ? 8px : 0px;
                property <string> session-key: row.key;
                changed session-key => { if !self.footer { ListState.avatar(row.key); } }
                init => { if !self.footer { ListState.avatar(row.key); Clock.row-layout(index, self.y, self.body-height); } }
                changed y => { if !self.footer { Clock.row-layout(index, self.y, self.body-height); } }
                changed height => { if !self.footer { Clock.row-layout(index, self.y, self.body-height); } }
                height: self.body-height + self.group-spacing;
                footer-content := VerticalLayout {
                    visible: row-box.footer; width: parent.width; height: row-box.body-height;
                    padding-top: 8px; padding-bottom: ListState.cast-visible ? 72px : 8px;
                    padding-left: 12px; padding-right: 12px; spacing: 4px;
                    if row-box.footer && ListState.recent-window != "": Text {
                        text: ListState.recent-window; color: Theme.on-surface-variant; wrap: word-wrap; horizontal-alignment: center;
                    }
                    if row-box.footer && ListState.recent-more-error != "": Text {
                        text: ListState.recent-more-error; color: Theme.error; wrap: word-wrap; horizontal-alignment: center;
                    }
                    if row-box.footer && ListState.recent-more-label != "": TextButton {
                        text: ListState.recent-more-label; enabled: ListState.recent-more-enabled;
                        border-width: root.keyboard-index == index && list-focus.has-focus ? 2px : 0px; border-color: Theme.primary;
                        clicked => { ListState.load-more-recent(); }
                    }
                }
                if !row-box.footer: Rectangle {
                    accessible-role: list-item; accessible-label: row.title + ", " + row.subtitle + (row.pinned ? ", " + Labels.pinned-sessions : "") + (row.favorite ? ", " + Labels.favorite-sessions : "") + (row.activity == "" ? "" : ", " + row.activity) + (row.permission == "" ? "" : ", " + row.permission) + (row.unread-label == "" ? "" : ", " + row.unread-label);
                    accessible-action-default => { ListState.open(row.key); }
                    x: 0px; y: 0px; width: parent.width; height: parent.body-height; border-radius: 12px;
                    background: row.selected ? Theme.secondary-container : row-touch.pressed ? Theme.on-surface.with-alpha(0.12) : row-touch.has-hover ? Theme.on-surface.with-alpha(0.08) : transparent;
                    border-width: root.keyboard-index == index && list-focus.has-focus ? 2px : 0px; border-color: Theme.primary;
                }
                if row.selected: Rectangle { x: 0px; y: 0px; width: parent.width; height: parent.body-height; border-radius: 12px; background: row-touch.pressed ? Theme.on-surface.with-alpha(0.12) : row-touch.has-hover ? Theme.on-surface.with-alpha(0.08) : transparent; }
                row-touch := TouchArea { enabled: !row-box.footer; x: 0px; y: 0px; width: parent.width; height: parent.body-height;
                    clicked => { root.keyboard-index = index; list-focus.focus(); ListState.open(row.key); }
                    pointer-event(event) => { if !row.sub && event.button == PointerEventButton.right && event.kind == PointerEventKind.up { actions.menu-x = self.mouse-x; actions.show(); } }
                }
                actions := SessionActions { x: 0px; y: 0px; width: parent.width; height: 0px; session: row; }
                property <int> menu-request: root.menu-request;
                changed menu-request => { if root.keyboard-index == index && !self.footer { actions.menu-x = 60px; actions.show(); } }
                content := HorizontalLayout { visible: !row-box.footer; x: 0px; y: 0px; width: parent.width; height: parent.body-height; padding-top: row.sub ? 0px : 6px; padding-bottom: row.sub ? 0px : 6px; spacing: row.sub ? 0px : 12px;
                    if row.sub: Rectangle { width: 40px;
                        Rectangle { x: 23.25px; width: 1.5px; height: row.sub-last ? parent.height / 2 : parent.height; background: Theme.outline-variant; }
                        Rectangle { x: 24px; y: parent.height / 2 - 0.75px; width: 16px; height: 1.5px; background: Theme.outline-variant; }
                    }
                    VerticalLayout { alignment: center; Avatar { width: row.sub ? 24px : 48px; height: self.width; source: row.avatar; initials: row.initials; brand: row.brand; brand-color: row.brand-color; fallback-color: row.fallback-color; label: row.title; } }
                    VerticalLayout { padding-left: row.sub ? 8px : 0px; spacing: 0px; horizontal-stretch: 1;
                        HorizontalLayout { spacing: 8px;
                            Tooltip { text: row.title; height: min(title.preferred-height, row.sub ? 20px : 48px); horizontal-stretch: 1;
                                clicked => { root.keyboard-index = index; list-focus.focus(); ListState.open(row.key); }
                                // Avatar (48 px) + espaço (12 px) antes do título.
                                pointer-event(event, x) => { if !row.sub && event.button == PointerEventButton.right && event.kind == PointerEventKind.up { actions.menu-x = 60px + x; actions.show(); } }
                                title := Text { x: 0px; y: 0px; width: parent.width; height: parent.height; text: row.title; color: Theme.on-surface; font-size: row.sub ? 14px : 16px; letter-spacing: 0.5px; line-height-factor: row.sub ? 20px / subtitle-metrics.preferred-height : 24px / body-metrics.preferred-height; font-weight: row.unread != "" ? 700 : 400; wrap: word-wrap; overflow: elide; }
                            }
                            if !row.sub: VerticalLayout { padding-top: 4px; alignment: start; horizontal-stretch: 0;
                                Text { text: row.time; color: row.unread != "" ? Theme.primary : Theme.on-surface-variant; font-size: 11px; letter-spacing: 0.5px; }
                            }
                        }
                        HorizontalLayout { spacing: 8px;
                            Text { text: row.subtitle; color: Theme.on-surface-variant; font-size: row.sub ? 12px : 14px; letter-spacing: 0.25px; line-height-factor: 20px / subtitle-metrics.preferred-height; overflow: elide; font-weight: row.unread != "" ? 700 : 400; horizontal-stretch: 1; }
                            if !row.sub && row.unread != "": VerticalLayout { alignment: center; horizontal-stretch: 0; Badge { text: row.unread; } }
                        }
                        if row.pinned || row.favorite: Text { text: (row.pinned ? Labels.pinned-sessions : "") + (row.pinned && row.favorite ? " · " : "") + (row.favorite ? Labels.favorite-sessions : ""); color: Theme.primary; font-size: 12px; overflow: elide; }
                        if row.activity != "": HorizontalLayout {
                            height: 20px; spacing: 3px;
                            Text { height: 20px; text: Clock.spinner(row.codex, Clock.tick, Clock.focused); font-family: "DejaVu Sans"; color: Theme.primary; font-size: 12px; vertical-alignment: center; horizontal-stretch: 0; }
                            Text { height: 20px; text: row.working && row.since != "" ? Clock.activity(row.activity-text, row.since, Clock.tick) : row.activity; color: Theme.primary; font-size: 12px; vertical-alignment: center; overflow: elide; horizontal-stretch: 1; }
                        }
                        if row.permission != "": TextButton { text: row.permission; foreground: Theme.error; clicked => { ListState.permission(row.key); } }
                    }
                }
            }
        }
        if ListState.quotas.length > 0: VerticalLayout {
            vertical-stretch: 0; alignment: start;
            // O FAB de elenco ocupa o canto inferior direito.
            padding-top: 2px; padding-bottom: ListState.cast-visible ? 80px : 8px; spacing: 4px;
            Rectangle { height: 1px; background: Theme.outline-variant; }
            Text { text: ListState.quota-title; color: Theme.on-surface-variant; font-size: 11px; }
            // Uma linha por provedor: nome, renovação, barra curta e percentual.
            for quota in ListState.quotas: HorizontalLayout { spacing: 8px; height: 18px;
                accessible-role: text; accessible-label: quota.label + ", " + quota.percent + (quota.resets == "" ? "" : ", " + quota.resets);
                Text { text: quota.label; color: Theme.on-surface; font-size: 12px; overflow: elide; vertical-alignment: center; horizontal-stretch: 1; }
                if quota.resets != "": Text { text: quota.resets; color: Theme.on-surface-variant; font-size: 11px; vertical-alignment: center; horizontal-stretch: 0; }
                VerticalLayout { alignment: center; horizontal-stretch: 0;
                    Rectangle { width: 72px; height: 4px; border-radius: 2px; background: Theme.surface-container-highest;
                        Rectangle { x: 0px; width: parent.width * quota.fraction; height: parent.height; border-radius: 2px; background: quota.severity == 2 ? Theme.error : quota.severity == 1 ? StatusColors.warning : Theme.primary; }
                    }
                }
                Text { text: quota.percent; width: 34px; horizontal-alignment: right; vertical-alignment: center; color: quota.severity == 2 ? Theme.error : quota.severity == 1 ? StatusColors.warning : Theme.on-surface-variant; font-size: 12px; horizontal-stretch: 0; }
            }
        }
        }
    }
    // Ponto de montagem do FAB: o recurso de elenco fornece ícone e callback.
    if ListState.cast-visible: Fab { x: parent.width - 72px; y: parent.height - 72px; icon: ListState.cast-icon; label: Labels.cast-start;
        clicked => { ListState.cast(); }
    }
    menu := Menu { x: root.width - 52px; y: 56px; width: 150px;
        TextButton { min-height: 48px; preferred-height: 48px; text: Labels.settings; text-weight: 400; foreground: Theme.on-surface; horizontal-alignment: left; border-radius: 0px; clicked => { menu.close(); ListState.menu-open = false; ListState.settings(); } }
        TextButton { min-height: 48px; preferred-height: 48px; text: Labels.add-server; text-weight: 400; foreground: Theme.on-surface; horizontal-alignment: left; border-radius: 0px; clicked => { menu.close(); ListState.menu-open = false; ListState.add-server(); } }
        TextButton { min-height: 48px; preferred-height: 48px; text: FilesState.title; text-weight: 400; foreground: Theme.on-surface; horizontal-alignment: left; border-radius: 0px; clicked => { menu.close(); ListState.menu-open = false; FilesState.open(false); } }
    }
}
