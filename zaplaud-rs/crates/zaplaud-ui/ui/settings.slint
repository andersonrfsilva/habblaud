import { Theme, StatusColors } from "resources.slint";
import { TextButton, IconButton, RadioButton, Switch, Chip, Dialog, ScrollContainer, TextField } from "widgets/kit.slint";
import { MaterialIcons } from "widgets/material-icons.slint";
import { Palette } from "std-widgets.slint";
import { ListState } from "list.slint";
export struct SettingsRow { kind: string, key: string, text: string, detail: string, value: string, checked: bool, enabled: bool, fraction: float, severity: int, card: bool }
export global SettingsState {
    in-out property <string> theme-mode: "system";
    private property <bool> system-dark: Palette.color-scheme == ColorScheme.dark;
    out property <bool> resolved-dark: self.theme-mode == "dark" || (self.theme-mode == "system" && self.system-dark);
    changed theme-mode => { Theme.dark = self.theme-mode == "dark" || (self.theme-mode == "system" && self.system-dark); }
    changed system-dark => { if self.theme-mode == "system" { Theme.dark = self.system-dark; } }
    private property <bool> app-visible: ListState.app-visible;
    changed app-visible => { self.active-changed(self.app-visible); }
    callback active-changed(bool);
    in-out property <bool> visible;
    in property <string> title;
    in property <string> back;
    in property <string> cancel;
    in property <string> use-label;
    in property <string> model-placeholder;
    in property <[SettingsRow]> rows;
    in property <[SettingsRow]> servers;
    in-out property <string> origin;
    in-out property <string> editing-role;
    in property <string> role-title;
    in property <string> role-prompt;
    in property <[SettingsRow]> choices;
    in-out property <string> typed;
    in property <bool> typed-valid;
    in property <bool> choosing-model;
    callback close();
    callback preferences-changed();
    callback notification-preferences-changed();
    callback cancel-edit();
    callback choose(string);
    callback activate(string, string, bool);
    callback edit-role(string);
    callback model(string);
    callback thinking(string);
    callback typed-changed(string);
}
component Section inherits Rectangle {
    in property <string> text;
    height: 44px;
    Text { x: 16px; y: 20px; text: root.text; color: Theme.primary; font-size: 14px; font-weight: 500; }
}
export component SettingsPane inherits Rectangle {
    background: Theme.background;
    forward-focus: settings-keys;
    Rectangle { x: 0px; y: 0px; width: root.width; height: 64px; background: Theme.surface; }
    init => { settings-keys.focus(); }
    settings-keys := FocusScope {
        enabled: SettingsState.editing-role == "";
        changed enabled => { if self.enabled { self.focus(); } }
        key-released(event) => {
            if event.text == Key.Escape {
                SettingsState.close();
                return accept;
            }
            return reject;
        }
    VerticalLayout { spacing: 0px;
        HorizontalLayout { height: 64px; padding-left: 8px; spacing: 8px;
            VerticalLayout { width: 40px; alignment: center; IconButton { icon: MaterialIcons.arrow-back; label: SettingsState.back; clicked => { SettingsState.close(); } } }
            Text { horizontal-stretch: 1; text: SettingsState.title; font-size: 22px; color: Theme.on-surface; vertical-alignment: center; }
        }
        ScrollContainer {
            VerticalLayout { padding-bottom: 24px; spacing: 0px;
                if SettingsState.servers.length > 1: HorizontalLayout { padding-left: 16px; padding-right: 16px; spacing: 8px;
                    for server in SettingsState.servers: Chip { text: server.text; selected: SettingsState.origin == server.key; clicked => { SettingsState.choose(server.key); } }
                    Rectangle {}
                }
                for row in SettingsState.rows: Rectangle {
                    height: row.kind == "quota-end" ? 22px : row.kind == "section" ? 44px : row.kind == "hint" ? max(28px, hint.preferred-height + 8px) : row.kind == "quota" ? 46px : row.kind == "role" ? 60px : row.kind == "radio" ? 44px : row.kind == "switch" ? 52px : 48px;
                    if row.card && row.kind != "quota" && row.kind != "quota-end": Rectangle { x: 16px; width: parent.width - 32px; background: Theme.surface-container-high; }
                    if row.kind == "quota-end": Rectangle { x: 16px; y: 0px; width: parent.width - 32px; height: parent.height - 6px; border-bottom-left-radius: 16px; border-bottom-right-radius: 16px; background: Theme.surface-container-high; }
                    if row.kind == "section": Section { text: row.text; }
                    hint := Text { visible: row.kind == "hint"; x: row.card ? 32px : 16px; y: 4px; width: parent.width - (row.card ? 64px : 32px); text: row.text; wrap: word-wrap; font-size: row.key == "no-quota" ? 14px : 12px; color: row.severity == 2 ? Theme.error : Theme.on-surface-variant; }
                    if row.kind == "radio": RadioButton { x: 16px; width: parent.width - 32px; height: parent.height; indicator-width: 24px; label-spacing: 12px; text: row.text; checked: row.checked; enabled: row.enabled; toggled => { SettingsState.activate(row.key, row.value, true); } }
                    if row.kind == "switch": Switch { x: 16px; width: parent.width - 32px; height: parent.height; text: row.text; checked: row.checked; enabled: row.enabled; toggled => { SettingsState.activate(row.key, "", self.checked); } }
                    if row.kind == "role": TextButton { x: 8px; width: parent.width - 16px; height: parent.height; text: ""; accessible-label: row.text + ", " + row.detail; enabled: row.enabled; clicked => { SettingsState.edit-role(row.key); }
                        VerticalLayout { padding-left: 8px; padding-right: 8px; padding-top: 10px; padding-bottom: 10px; spacing: 2px;
                            Text { text: row.text; font-size: 16px; color: Theme.on-surface; }
                            Text { text: row.detail; font-size: 12px; color: Theme.on-surface-variant; overflow: elide; }
                        }
                    }
                    if row.kind == "server": HorizontalLayout { padding-left: 16px; padding-right: 8px;
                        Text { text: row.text; font-size: 16px; color: Theme.on-surface; vertical-alignment: center; }
                        TextButton { width: 80px; horizontal-stretch: 0; text: row.detail; foreground: Theme.error; clicked => { SettingsState.activate("logout", row.key, false); } }
                    }
                    if row.kind == "button": TextButton { x: 8px; width: self.min-width; text: row.text; clicked => { SettingsState.activate(row.key, row.value, false); } }
                    if row.kind == "quota": Rectangle { x: 16px; y: 6px; width: parent.width - 32px; height: parent.height - 6px; border-top-left-radius: 16px; border-top-right-radius: 16px; background: Theme.surface-container-high;
                        HorizontalLayout { x: 16px; y: 16px; width: parent.width - 32px; height: 24px; spacing: 8px;
                            Text { text: row.text; font-size: 16px; font-weight: 500; color: Theme.on-surface; vertical-alignment: center; horizontal-stretch: 1; }
                            Text { text: row.detail; font-size: 11px; letter-spacing: 0.5px; color: row.severity == 1 ? StatusColors.warning : Theme.on-surface-variant; vertical-alignment: center; horizontal-stretch: 0; }
                        }
                    }
                    if row.kind == "limit": VerticalLayout { padding-left: 32px; padding-right: 32px; spacing: 4px;
                        HorizontalLayout { Text { text: row.text; color: Theme.on-surface; font-size: 14px; } Text { text: row.detail; color: row.severity == 2 ? Theme.error : Theme.on-surface; font-size: 14px; horizontal-alignment: right; } }
                        if row.value != "": Rectangle { height: 4px; background: Theme.surface-container-highest;
                            Rectangle { width: parent.width * row.fraction; background: row.severity == 2 ? Theme.error : row.severity == 1 ? StatusColors.warning : Theme.primary; }
                        }
                    }
                }
            }
        }
    }
    }
    if SettingsState.editing-role != "": Dialog {
        title: SettingsState.role-title; cancel: SettingsState.cancel;
        dialog-width: 560px;
        private property <bool> choosing-model: SettingsState.choosing-model;
        changed choosing-model => { self.focus-dialog(); }
        dismissed => { SettingsState.cancel-edit(); }
        ScrollContainer { height: min(360px, role-content.preferred-height); content-width: self.width;
            role-content := VerticalLayout { width: parent.width; spacing: 2px;
                Text { text: SettingsState.role-prompt; font-size: 14px; color: Theme.on-surface-variant; }
                for row in SettingsState.choices: Rectangle { height: row.kind == "hint" ? max(20px, role-hint.preferred-height) : row.kind == "section" ? 32px : 44px;
                    role-hint := Text { visible: row.kind == "hint"; width: parent.width; text: row.text; color: Theme.on-surface-variant; font-size: 12px; wrap: word-wrap; }
                    if row.kind == "section": Text { text: row.text; color: Theme.primary; font-size: 14px; vertical-alignment: center; }
                    if row.kind == "radio": RadioButton { text: row.text; checked: row.checked; toggled => { if SettingsState.choosing-model { SettingsState.model(row.value); } else { SettingsState.thinking(row.value); } } }
                }
                if SettingsState.choosing-model: Rectangle { height: 64px;
                    TextField {
                        y: 8px; width: parent.width; height: 56px; placeholder: SettingsState.model-placeholder; text <=> SettingsState.typed; outlined: true; trailing-space: 68px;
                        edited(value) => { SettingsState.typed-changed(value); }
                        TextButton { x: parent.width - 76px; y: 8px; width: 68px; text: SettingsState.use-label; enabled: SettingsState.typed-valid; clicked => { SettingsState.model(SettingsState.typed); } }
                    }
                }
            }
        }
    }
}
