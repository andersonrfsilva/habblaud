import { ScrollView, ListView } from "std-widgets.slint";
import { Theme } from "resources.slint";
import { IconButton } from "../widgets/kit.slint";
import { MaterialIcons } from "../widgets/material-icons.slint";
import { DiagramState, MarkdownImages, PlaybackImage } from "diagram.slint";
export { Theme }

export struct MdSpan {
    text: string, bold: bool, italic: bool, strike: bool, code: bool, link: string,
}
export struct MdCell {
    rich: styled-text, text: string, spans: [MdSpan], alignment: int, header: bool,
}
export struct MdBlock {
    kind: string, rich: styled-text, text: string, spans: [MdSpan],
    copy-text: string,
    continued-before: bool, continued-after: bool,
    level: int, depth: int, marker: string, language: string,
    links: [string],
    link-labels: [string],
    code-lines: int, layout-lines: int, diagram: image,
    cells: [MdCell], columns: int,
}

export global MarkdownGeometry {
    in property <int> request;
    callback measured(string, float, float, float, float);
}

export struct FindMark { start: int, end: int, index: int }
export struct FindCodeMark { line: int, prefix: string, text: string, index: int, first: bool }
export struct FindCodePreview { text: string, marks: [FindCodeMark], lines: int }
export struct FindPaint { rich: styled-text, prefix: styled-text, active: bool }

export global MarkdownFind {
    in property <int> revision;
    in property <int> current: -1;
    in-out property <int> request;
    in-out property <bool> measured;
    in-out property <length> measured-y;
    in-out property <length> measured-height;
    in-out property <string> probe-row;
    in-out property <int> probe-request;
    in-out property <int> probe-best: -1;
    in-out property <length> probe-top;
    pure callback prefix(string, int) -> string;
    pure callback marks(string, int, int, int) -> [FindMark];
    pure callback paint(styled-text, string, [MdSpan], [FindMark], int, color, color, bool, bool) -> FindPaint;
    pure callback code-marks(string, [FindMark]) -> [FindCodeMark];
    pure callback diagram-source(string, [FindMark], int) -> FindCodePreview;
    public function report(y: length, height: length) {
        MarkdownFind.measured-y = y;
        MarkdownFind.measured-height = height;
        MarkdownFind.measured = true;
    }
    public function report-near(index: int, bottom: length) {
        if bottom > MarkdownFind.probe-top && (MarkdownFind.probe-best < 0 || index < MarkdownFind.probe-best) {
            MarkdownFind.probe-best = index;
        }
    }
}

export global MarkdownSelection {
    out property <string> select-message-label: "Selecionar a mensagem toda";
    callback format([MdBlock]) -> string;
}

export component MeasuredText inherits FocusScope {
    in property <string> row-id;
    in property <styled-text> text;
    in property <brush> default-color <=> body.default-color;
    in property <length> default-font-size <=> body.default-font-size;
    in property <color> link-color <=> body.link-color;
    in property <TextHorizontalAlignment> horizontal-alignment <=> body.horizontal-alignment;
    callback link-clicked(string);
    callback copy-message();
    focus-on-click: false;
    in property <string> find-text;
    in property <[MdSpan]> find-spans;
    in property <int> find-block: -2;
    in property <int> find-cell: -1;
    in property <bool> find-bold;
    in property <bool> find-italic;
    in property <color> find-ink: Theme.primary;
    in property <color> find-current-ink: Theme.tertiary;
    in property <length> find-viewport-height;
    callback reveal();
    property <[FindMark]> find-marks: root.find-block == -2 || MarkdownFind.revision == 0 ? []
        : MarkdownFind.marks(root.row-id, root.find-block, root.find-cell, MarkdownFind.revision);
    property <FindPaint> find-paint: root.find-marks.length == 0 ? { rich: root.text }
        : MarkdownFind.paint(root.text, root.find-text, root.find-spans, root.find-marks, MarkdownFind.current,
            root.find-ink, root.find-current-ink, root.find-bold, root.find-italic);
    property <int> find-request: root.find-paint.active ? MarkdownFind.request : 0;
    changed find-request => {
        if root.find-paint.active {
            root.reveal();
            let tall = root.find-viewport-height > 0px && root.height > root.find-viewport-height - 8px;
            let offset = tall ? max(0px, find-prefix.preferred-height - find-line.preferred-height) : 0px;
            MarkdownFind.report(root.absolute-position.y + offset, tall ? find-line.preferred-height : root.height);
        }
    }
    find-prefix := StyledText {
        visible: false; width: root.width; text: root.find-paint.prefix;
        default-font-size: root.default-font-size;
    }
    find-line := StyledText {
        visible: false; width: root.width; text: @markdown("M");
        default-font-size: root.default-font-size;
    }
    property <bool> probing: root.row-id == MarkdownFind.probe-row && root.find-marks.length > 0;
    property <int> near-request: root.probing ? MarkdownFind.probe-request : 0;
    changed near-request => {
        if root.probing && root.absolute-position.y >= MarkdownFind.probe-top {
            MarkdownFind.report-near(root.find-marks[0].index, root.absolute-position.y + root.height);
        }
    }
    if root.probing && root.absolute-position.y < MarkdownFind.probe-top
        && root.absolute-position.y + root.height > MarkdownFind.probe-top: Rectangle {
        for mark in root.find-marks: StyledText {
            visible: false; width: root.width;
            default-font-size: root.default-font-size;
            text: @markdown("\{MarkdownFind.prefix(root.find-text, mark.end)}");
            property <int> probe-request: MarkdownFind.probe-request;
            changed probe-request => {
                MarkdownFind.report-near(mark.index, root.absolute-position.y + self.preferred-height);
            }
        }
    }
    min-width: body.min-width;
    preferred-width: body.preferred-width;
    preferred-height: body.preferred-height;
    // A altura explícita preserva a medida na largura renderizada ao agregar os layouts ancestrais.
    height: self.preferred-height;
    capture-key-pressed(event) => {
        if (event.modifiers.control || event.modifiers.meta) && event.text.to-lowercase() == "c" {
            if !body.has-selection { root.copy-message(); return accept; }
            // Ctrl (Cmd no macOS) sem Shift segue para o atalho nativo do StyledText.
            if !event.modifiers.control || event.modifiers.shift { body.copy(); return accept; }
        }
        return reject;
    }
    body := StyledText {
        width: parent.width;
        height: parent.height;
        text: root.find-paint.rich;
        selectable: true;
        selection-background-color: Theme.primary;
        selection-foreground-color: Theme.on-primary;
        link-clicked(url) => { root.link-clicked(url); }
        property <int> request: MarkdownGeometry.request;
        changed request => {
            MarkdownGeometry.measured(root.row-id, self.absolute-position.y / 1px, self.height / 1px, self.preferred-height / 1px, self.width / 1px);
        }
        @children
    }
}

export component MeasuredInput inherits TextInput {
    callback copy-message();
    public function copy-shortcut(event: KeyEvent) -> EventResult {
        if (event.modifiers.control || event.modifiers.meta) && event.text.to-lowercase() == "c" {
            if !root.has-selection { root.copy-message(); return accept; }
            if !event.modifiers.control || event.modifiers.shift { root.copy(); return accept; }
        }
        return reject;
    }
    in property <string> row-id;
    property <int> request: MarkdownGeometry.request;
    changed request => {
        MarkdownGeometry.measured(root.row-id, self.absolute-position.y / 1px, self.height / 1px, self.preferred-height / 1px, self.width / 1px);
    }
}

component MdButton inherits Rectangle {
    in property <string> text;
    callback clicked;
    min-width: label.preferred-width + 24px;
    min-height: 32px;
    horizontal-stretch: 0;
    vertical-stretch: 0;
    border-radius: 6px;
    border-width: focus.has-focus ? 2px : 1px;
    border-color: focus.has-focus ? Theme.primary : Theme.outline-variant;
    background: touch.has-hover ? Theme.surface-container-high : Theme.surface-container-low;
    accessible-role: button;
    accessible-label: root.text;
    accessible-action-default => { root.clicked(); }
    forward-focus: focus;
    label := Text {
        width: 100%;
        height: 100%;
        text: root.text;
        color: Theme.primary;
        font-size: 12px;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    touch := TouchArea {
        width: 100%;
        height: 100%;
        mouse-cursor: pointer;
        clicked => { focus.focus(); root.clicked(); }
    }
    focus := FocusScope {
        width: 0px;
        height: 0px;
        key-pressed(event) => {
            if event.text == Key.Space || event.text == Key.Return {
                root.clicked();
                return accept;
            }
            return reject;
        }
    }
}

component FormattedBlock inherits VerticalLayout {
    in property <MdBlock> block;
    in property <string> row-id;
    in property <int> find-block: -2;
    in property <length> find-viewport-height;
    in property <color> find-ink: Theme.primary;
    in property <color> find-current-ink: Theme.tertiary;
    callback link-clicked(string);
    callback copy(string);
    callback select-text();
    in property <string> source-markdown;
    in property <color> foreground: Theme.on-surface;
    spacing: 3px;
    HorizontalLayout {
        Text { text: root.block.marker; color: root.foreground; width: root.block.marker == "" ? 0px : self.preferred-width + 6px; }
        VerticalLayout {
            MeasuredText {
                row-id: root.row-id;
                text: root.block.rich;
                find-text: root.block.text; find-spans: root.block.spans; find-block: root.find-block;
                find-bold: root.block.level > 0; find-italic: root.block.kind == "quote";
                find-viewport-height: root.find-viewport-height;
                find-ink: root.find-ink; find-current-ink: root.find-current-ink;
                default-color: root.foreground;
                default-font-size: root.block.level == 1 ? 24px : root.block.level == 2 ? 22px : root.block.level == 3 ? 16px : root.block.level == 4 ? 14px : root.block.level == 5 ? 16px : root.block.level == 6 || root.block.kind == "quote" ? 14px : 16px;
                link-color: Theme.primary;
                link-clicked(url) => { root.link-clicked(url); }
                copy-message => { root.copy(root.source-markdown); }
                ContextMenuArea {
                    Menu {
                        MenuItem { title: "Copiar mensagem"; activated => { root.copy(root.source-markdown); } }
                        MenuItem { title: MarkdownSelection.select-message-label; activated => { root.select-text(); } }
                        for link[index] in root.block.links: MenuItem {
                            title: "Copiar link: " + root.block.link-labels[index];
                            activated => { root.copy(link); }
                        }
                    }
                }
            }
        }
    }
}

export component MarkdownView inherits Rectangle {
    in property <[MdBlock]> blocks;
    in property <string> source-markdown;
    in property <string> row-id;
    in property <length> viewport-top;
    in property <length> viewport-bottom;
    in property <color> find-ink: Theme.primary;
    in property <color> find-current-ink: Theme.tertiary;
    callback link-clicked(string);
    callback copy(string);
    callback before-selection-change();
    in property <int> selection-generation;
    private property <bool> selecting: false;
    private property <string> plain-text;
    function select-text() {
        if !root.selecting {
            root.plain-text = MarkdownSelection.format(root.blocks);
            root.before-selection-change();
            root.selecting = true;
        }
    }
    function stop-selecting(restore-focus: bool) {
        if root.selecting {
            root.before-selection-change();
            root.selecting = false;
            root.plain-text = "";
            if restore-focus { message-focus.focus(); }
        }
    }
    changed selection-generation => {
        root.selecting = false;
        root.plain-text = "";
    }
    changed row-id => {
        root.selecting = false;
        root.plain-text = "";
    }
    in property <color> foreground: Theme.on-surface;
    preferred-height: content.preferred-height;
    vertical-stretch: 0;
    horizontal-stretch: 1;
    forward-focus: message-focus;
    message-menu := ContextMenuArea {
        // O menu nativo tira o foco do campo; durante a seleção, Esc ou clique fora encerra o modo.
        enabled: !root.selecting;
        Menu {
            MenuItem { title: "Copiar mensagem"; activated => { root.copy(root.source-markdown); } }
            MenuItem { title: MarkdownSelection.select-message-label; activated => { root.select-text(); } }
        }
        hover := TouchArea {
            clicked => { message-focus.focus(); }
            message-focus := FocusScope {
                focus-on-click: false;
                key-pressed(event) => {
                    if !root.selecting && (event.modifiers.control || event.modifiers.meta) && event.text.to-lowercase() == "c" {
                        root.copy(root.source-markdown); return accept;
                    }
                    return reject;
                }
    content := VerticalLayout {
    spacing: 8px;
    if root.selecting: MeasuredInput {
        init => { self.focus(); }
        row-id: root.row-id;
        height: self.preferred-height;
        vertical-stretch: 0;
        text: root.plain-text;
        accessible-label: MarkdownSelection.select-message-label;
        read-only: true;
        single-line: false;
        wrap: word-wrap;
        color: root.foreground;
        font-size: 16px;
        selection-background-color: Theme.primary;
        selection-foreground-color: Theme.on-primary;
        changed has-focus => {
            if !self.has-focus { root.stop-selecting(false); }
        }
        key-pressed(event) => {
            if event.text == Key.Escape { return accept; }
            return self.copy-shortcut(event);
        }
        copy-message => { root.copy(root.source-markdown); }
        key-released(event) => {
            if event.text == Key.Escape { root.stop-selecting(true); return accept; }
            return reject;
        }
    }
    if !root.selecting: VerticalLayout {
    spacing: 8px;
    for block[block-index] in root.blocks: VerticalLayout {
        padding-left: min(block.depth, 4) * 20px;
        if block.kind == "rule": Rectangle { height: 1px; background: Theme.outline-variant; }
        if block.kind == "text": FormattedBlock {
            block: block;
            find-block: block-index; find-viewport-height: root.viewport-bottom - root.viewport-top;
            find-ink: root.find-ink; find-current-ink: root.find-current-ink;
            row-id: root.row-id;
            foreground: root.foreground;
            source-markdown: root.source-markdown;
            copy(text) => { root.copy(text); }
            select-text => { root.select-text(); }
            link-clicked(url) => { message-focus.focus(); root.link-clicked(url); }
        }
        if block.kind == "quote": HorizontalLayout {
            spacing: 8px;
            Rectangle { width: 3px; background: Theme.outline-variant; }
            FormattedBlock {
                row-id: root.row-id; block: block; foreground: root.foreground; source-markdown: root.source-markdown;
                find-block: block-index; find-viewport-height: root.viewport-bottom - root.viewport-top;
                find-ink: root.find-ink; find-current-ink: root.find-current-ink;
                copy(text) => { root.copy(text); } select-text => { root.select-text(); }
                link-clicked(url) => { message-focus.focus(); root.link-clicked(url); }
            }
        }
        if block.kind == "code": code-box := Rectangle {
            background: Theme.on-background.with-alpha(0.1);
            border-top-left-radius: block.continued-before ? 0px : 8px;
            border-top-right-radius: self.border-top-left-radius;
            border-bottom-left-radius: block.continued-after ? 0px : 8px;
            border-bottom-right-radius: self.border-bottom-left-radius;
            preferred-height: code-content.preferred-height;
            property <[FindMark]> marks: MarkdownFind.revision == 0 ? []
                : MarkdownFind.marks(root.row-id, block-index, -1, MarkdownFind.revision);
            property <bool> reveal-source: block.diagram.width > 0 && self.marks.length > 0;
            property <FindCodePreview> source: self.reveal-source
                ? MarkdownFind.diagram-source(block.text, self.marks, MarkdownFind.current)
                : { text: block.text, lines: block.layout-lines,
                    marks: self.marks.length == 0 ? [] : MarkdownFind.code-marks(block.text, self.marks) };
            code-metrics := Text { visible: false; text: code-box.source.text; font-family: "Noto Sans Mono"; font-size: 14px; wrap: no-wrap; }
            ContextMenuArea {
                Menu {
                    MenuItem { title: "Copiar mensagem"; activated => { root.copy(root.source-markdown); } }
                    MenuItem { title: MarkdownSelection.select-message-label; activated => { root.select-text(); } }
                    MenuItem { title: "Copiar código"; activated => { root.copy(block.copy-text == "" ? block.text : block.copy-text); } }
                }
            code-content := VerticalLayout {
                padding: 8px;
                padding-top: block.continued-before ? 0px : 8px;
                padding-bottom: block.continued-after ? 0px : 8px;
                spacing: 4px;
                // O tema do renderizador é claro; o cartão branco mantém contraste no tema escuro.
                if block.diagram.width > 0 && !code-box.reveal-source: HorizontalLayout {
                    alignment: start;
                    Rectangle {
                        property <length> diagram-width: min(code-content.width - 16px, block.diagram.width * 1px);
                        width: self.diagram-width;
                        height: self.diagram-width * block.diagram.height / block.diagram.width;
                        background: white;
                        border-radius: 6px;
                        clip: true;
                        accessible-role: button;
                        accessible-label: "Diagrama";
                        accessible-action-default => { DiagramState.open(block.diagram); }
                        forward-focus: diagram-keys;
                        border-width: diagram-keys.has-focus ? 2px : 0px;
                        border-color: Theme.primary;
                        diagram-keys := FocusScope {
                            key-pressed(event) => {
                                if event.text == Key.Return || event.text == Key.Space { DiagramState.open(block.diagram); return accept; }
                                return reject;
                            }
                        }
                        Image {
                            source: block.diagram;
                            // Sem tamanho, a imagem fica no natural e o clip corta o desenho mais largo que o bloco.
                            width: parent.width;
                            height: parent.height;
                            image-fit: contain;
                            accessible-role: image;
                            accessible-label: "Diagrama";
                        }
                        TouchArea { clicked => { DiagramState.open(block.diagram); } }
                    }
                }
                if block.diagram.width == 0 || code-box.reveal-source: code-scroll := ScrollView {
                    min-height: 0px;
                    preferred-height: code.preferred-height + (code-metrics.preferred-width > self.width ? 12px : 0px);
                    max-height: self.preferred-height;
                    vertical-stretch: 0;
                    content-width: max(self.width, code-metrics.preferred-width);
                    for mark in code-box.source.marks: Rectangle {
                        property <bool> active: mark.index == MarkdownFind.current;
                        property <length> pitch: code.height / max(1, code-box.source.lines);
                        x: before.preferred-width; y: mark.line * self.pitch;
                        width: max(3px, matched.preferred-width); height: self.pitch;
                        background: root.find-ink.with-alpha(self.active ? 0.38 : 0.19);
                        Rectangle { y: parent.height - self.height; height: parent.active ? 2px : 1px; background: root.find-ink; }
                        before := Text { visible: false; text: mark.prefix; font-family: "Noto Sans Mono"; font-size: 14px; }
                        matched := Text { visible: false; text: mark.text; font-family: "Noto Sans Mono"; font-size: 14px; }
                        property <int> probe-request: mark.first && root.row-id == MarkdownFind.probe-row ? MarkdownFind.probe-request : 0;
                        changed probe-request => {
                            if root.row-id == MarkdownFind.probe-row && mark.first {
                                MarkdownFind.report-near(mark.index, self.absolute-position.y + self.height);
                            }
                        }
                        property <int> find-request: self.active && mark.first ? MarkdownFind.request : 0;
                        changed find-request => {
                            if self.active && mark.first {
                                if self.x + self.width > -code-scroll.content-x + code-scroll.width || self.x < -code-scroll.content-x {
                                    code-scroll.content-x = min(0px, max(code-scroll.width - code-scroll.content-width, 8px - self.x));
                                }
                                let tall = code-box.height > root.viewport-bottom - root.viewport-top - 8px;
                                MarkdownFind.report(tall ? self.absolute-position.y : code-box.absolute-position.y, tall ? self.height : code-box.height);
                            }
                        }
                    }
                    code := MeasuredInput {
                        row-id: root.row-id;
                        width: max(parent.width, code-metrics.preferred-width);
                        // A medida nativa inclui a última linha vazia e as métricas reais da fonte.
                        height: self.preferred-height;
                        text: code-box.source.text;
                        accessible-role: text; accessible-label: self.text;
                        read-only: true;
                        single-line: false;
                        wrap: no-wrap;
                        font-family: "Noto Sans Mono";
                        font-size: 14px;
                        color: root.foreground;
                        selection-background-color: Theme.primary;
                        selection-foreground-color: Theme.on-primary;
                        key-pressed(event) => { return self.copy-shortcut(event); }
                        copy-message => { root.copy(root.source-markdown); }
                    }
                }
            }
            }
            if hover.has-hover: IconButton {
                x: parent.width - 32px; y: 8px;
                width: 24px; height: 24px; icon: MaterialIcons.content-copy; label: "Copiar código";
                clicked => { root.copy(block.copy-text == "" ? block.text : block.copy-text); }
            }
        }
        if block.kind == "image": image-box := VerticalLayout {
            alignment: start;
            property <image> picture: MarkdownImages.get(block.text, MarkdownImages.revision);
            // `language` é a origem: só a remota espera o toque, para não vazar dados pela URL.
            init => { if block.language != "remote" { MarkdownImages.load(block.text); } }
            if image-box.picture.width > 0: HorizontalLayout {
                alignment: start;
                Rectangle {
                    property <length> picture-width: min(image-box.width, image-box.picture.width * 1px);
                    width: self.picture-width;
                    height: self.picture-width * image-box.picture.height / image-box.picture.width;
                    border-radius: 6px;
                    clip: true;
                    PlaybackImage {
                        width: parent.width; height: parent.height;
                        poster: image-box.picture;
                        destination: block.text;
                        // Uma linha longa pode estar na lista virtual com a imagem ainda cortada.
                        in-view: !DiagramState.visible && root.viewport-bottom > root.viewport-top
                            && self.absolute-position.y < root.viewport-bottom
                            && self.absolute-position.y + self.height > root.viewport-top;
                        accessible-role: image;
                        accessible-label: "Imagem";
                    }
                    TouchArea { clicked => { DiagramState.open-image(image-box.picture, block.text); } }
                }
            }
            if MarkdownImages.failed(block.text, MarkdownImages.revision): Text {
                text: MarkdownImages.failed-label;
                color: Theme.error;
                wrap: word-wrap;
            }
            if image-box.picture.width == 0 && block.language == "remote": HorizontalLayout {
                alignment: start;
                MdButton { text: "Carregar imagem"; clicked => { MarkdownImages.load(block.text); } }
            }
        }
        if block.kind == "table": table-scroll := ScrollView {
            height: table.preferred-height + 16px;
            content-width: max(self.width, block.columns * 180px);
            table := VerticalLayout {
                for row in block.cells.length / block.columns: HorizontalLayout {
                    spacing: 0px;
                    for column in block.columns: cell-box := Rectangle {
                        property <MdCell> cell: block.cells[row * block.columns + column];
                        width: 180px;
                        border-width: 1px;
                        border-color: Theme.outline-variant;
                        background: Theme.on-background.with-alpha(self.cell.header ? 0.06 : 0.02);
                        VerticalLayout {
                            padding: 8px;
                            MeasuredText {
                                row-id: root.row-id;
                                text: cell-box.cell.rich;
                                find-text: cell-box.cell.text; find-spans: cell-box.cell.spans;
                                find-block: block-index; find-cell: row * block.columns + column;
                                find-bold: cell-box.cell.header;
                                find-ink: root.find-ink; find-current-ink: root.find-current-ink;
                                find-viewport-height: root.viewport-bottom - root.viewport-top;
                                reveal => {
                                    let cell-x = column * cell-box.width;
                                    if cell-x + cell-box.width > -table-scroll.content-x + table-scroll.width || cell-x < -table-scroll.content-x {
                                        table-scroll.content-x = min(0px, max(table-scroll.width - table-scroll.content-width, -cell-x));
                                    }
                                }
                                default-color: root.foreground;
                                default-font-size: 16px;
                                link-color: Theme.primary;
                                horizontal-alignment: cell-box.cell.alignment == 1 ? center : cell-box.cell.alignment == 2 ? right : left;
                                link-clicked(url) => { message-focus.focus(); root.link-clicked(url); }
                                copy-message => { root.copy(root.source-markdown); }
                            }
                        }
                    }
                }
            }
        }
    }
    }
    HorizontalLayout {
        alignment: end;
        spacing: 4px;
        IconButton {
            width: 28px; height: 28px; icon: MaterialIcons.more-vert; label: "Ações da mensagem";
            enabled: !root.selecting;
            clicked => { message-menu.show({x: root.width - 28px, y: root.height}); }
        }
        IconButton { width: 28px; height: 28px; icon: MaterialIcons.content-copy; label: "Copiar mensagem"; clicked => { root.copy(root.source-markdown); message-focus.focus(); } }
    }
    }
            }
        }
    }
}

export struct MdMessage { blocks: [MdBlock], source: string }
export component MarkdownDemo inherits Window {
    title: "Zaplaud Markdown";
    width: 1000px;
    height: 760px;
    background: Theme.background;
    in property <[MdMessage]> messages;
    callback link-clicked(string);
    callback copy(string);
    public function copy-text(text: string) {
        clipboard.text = text;
        clipboard.select-all();
        clipboard.copy();
    }
    clipboard := TextInput { width: 0px; height: 0px; opacity: 0; }
    VerticalLayout {
        HorizontalLayout {
            MdButton { text: "Claro / escuro"; clicked => { Theme.dark = !Theme.dark; } }
        }
        ListView {
            for message in root.messages: Rectangle {
                background: Theme.surface;
                VerticalLayout {
                    padding: 12px;
                    MarkdownView {
                        blocks: message.blocks;
                        source-markdown: message.source;
                        link-clicked(url) => { root.link-clicked(url); }
                        copy(text) => { root.copy(text); }
                    }
                }
            }
        }
    }
}
