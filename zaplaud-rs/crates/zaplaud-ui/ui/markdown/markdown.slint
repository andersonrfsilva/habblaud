import { ScrollView, ListView } from "std-widgets.slint";
import { Theme } from "resources.slint";
import { IconButton } from "../widgets/kit.slint";
import { MaterialIcons } from "../widgets/material-icons.slint";
export { Theme }

export struct MdSpan {
    text: string, bold: bool, italic: bool, strike: bool, code: bool, link: string,
}
export struct MdCell {
    rich: styled-text, text: string, alignment: int, header: bool,
}
export struct MdBlock {
    kind: string, rich: styled-text, text: string, spans: [MdSpan],
    level: int, depth: int, marker: string, language: string,
    links: [string],
    link-labels: [string],
    code-lines: int,
    cells: [MdCell], columns: int,
}

export global MarkdownGeometry {
    in property <int> request;
    callback measured(string, float, float, float, float);
}

component MeasuredText inherits StyledText {
    // A altura explícita preserva a medida na largura renderizada ao agregar os layouts ancestrais.
    height: self.preferred-height;
    in property <string> row-id;
    property <int> request: MarkdownGeometry.request;
    changed request => {
        MarkdownGeometry.measured(root.row-id, self.absolute-position.y / 1px, self.height / 1px, self.preferred-height / 1px, self.width / 1px);
    }
}

export component MeasuredInput inherits TextInput {
    in property <string> row-id;
    property <int> request: MarkdownGeometry.request;
    changed request => {
        MarkdownGeometry.measured(root.row-id, self.absolute-position.y / 1px, self.height / 1px, self.preferred-height / 1px, self.width / 1px);
    }
}

component MdButton inherits Rectangle {
    in property <string> text;
    callback clicked;
    min-width: label.preferred-width + 24px;
    min-height: 32px;
    horizontal-stretch: 0;
    vertical-stretch: 0;
    border-radius: 6px;
    border-width: focus.has-focus ? 2px : 1px;
    border-color: focus.has-focus ? Theme.primary : Theme.outline-variant;
    background: touch.has-hover ? Theme.surface-container-high : Theme.surface-container-low;
    accessible-role: button;
    accessible-label: root.text;
    accessible-action-default => { root.clicked(); }
    forward-focus: focus;
    label := Text {
        width: 100%;
        height: 100%;
        text: root.text;
        color: Theme.primary;
        font-size: 12px;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    touch := TouchArea {
        width: 100%;
        height: 100%;
        mouse-cursor: pointer;
        clicked => { focus.focus(); root.clicked(); }
    }
    focus := FocusScope {
        width: 0px;
        height: 0px;
        key-pressed(event) => {
            if event.text == Key.Space || event.text == Key.Return {
                root.clicked();
                return accept;
            }
            return reject;
        }
    }
}

component SelectableBlock inherits VerticalLayout {
    in property <MdBlock> block;
    in property <string> row-id;
    callback link-clicked(string);
    callback copy(string);
    callback select-text();
    in property <string> source-markdown;
    in property <bool> selecting;
    in property <color> foreground: Theme.on-surface;
    spacing: 3px;
    HorizontalLayout {
        Text { text: root.block.marker; color: root.foreground; width: root.block.marker == "" ? 0px : self.preferred-width + 6px; }
        VerticalLayout {
            if !root.selecting: MeasuredText {
                row-id: root.row-id;
                text: root.block.rich;
                default-color: root.foreground;
                default-font-size: root.block.level == 1 ? 24px : root.block.level == 2 ? 22px : root.block.level == 3 ? 16px : root.block.level == 4 ? 14px : root.block.level == 5 ? 16px : root.block.level == 6 || root.block.kind == "quote" ? 14px : 16px;
                link-color: Theme.primary;
                link-clicked(url) => { root.link-clicked(url); }
                ContextMenuArea {
                    Menu {
                        MenuItem { title: "Copiar mensagem"; activated => { root.copy(root.source-markdown); } }
                        MenuItem { title: "Selecionar texto"; activated => { root.select-text(); } }
                        for link[index] in root.block.links: MenuItem {
                            title: "Copiar link: " + root.block.link-labels[index];
                            activated => { root.copy(link); }
                        }
                    }
                }
            }
            if root.selecting: MeasuredInput {
                row-id: root.row-id;
                text: root.block.text;
                accessible-role: text; accessible-label: root.block.text;
                read-only: true;
                wrap: word-wrap;
                color: root.foreground;
                font-size: 16px;
                selection-background-color: Theme.primary;
                selection-foreground-color: Theme.on-primary;
            }
        }
    }
}

export component MarkdownView inherits Rectangle {
    in property <[MdBlock]> blocks;
    in property <string> source-markdown;
    in property <string> row-id;
    callback link-clicked(string);
    callback copy(string);
    in-out property <bool> selecting: false;
    in property <color> foreground: Theme.on-surface;
    preferred-height: content.preferred-height;
    vertical-stretch: 0;
    horizontal-stretch: 1;
    forward-focus: message-focus;
    message-menu := ContextMenuArea {
        Menu {
            MenuItem { title: "Copiar mensagem"; activated => { root.copy(root.source-markdown); } }
            MenuItem { title: root.selecting ? "Texto formatado" : "Selecionar texto"; activated => { root.selecting = !root.selecting; } }
        }
        hover := TouchArea {
            clicked => { message-focus.focus(); }
            message-focus := FocusScope {
                capture-key-pressed(event) => {
                    if !root.selecting && event.modifiers.control && event.text.to-lowercase() == "c" {
                        root.copy(root.source-markdown); return accept;
                    }
                    return reject;
                }
    content := VerticalLayout {
    spacing: 8px;
    for block in root.blocks: VerticalLayout {
        padding-left: block.depth * 20px;
        if block.kind == "rule": Rectangle { height: 1px; background: Theme.outline-variant; }
        if block.kind == "text": SelectableBlock {
            block: block;
            row-id: root.row-id;
            foreground: root.foreground;
            selecting: root.selecting;
            source-markdown: root.source-markdown;
            copy(text) => { root.copy(text); }
            select-text => { root.selecting = true; }
            link-clicked(url) => { root.link-clicked(url); }
        }
        if block.kind == "quote": HorizontalLayout {
            spacing: 8px;
            Rectangle { width: 3px; background: Theme.outline-variant; }
            SelectableBlock { row-id: root.row-id; block: block; foreground: root.foreground; selecting: root.selecting; source-markdown: root.source-markdown; copy(text) => { root.copy(text); } select-text => { root.selecting = true; } link-clicked(url) => { root.link-clicked(url); } }
        }
        if block.kind == "code": code-box := Rectangle {
            background: Theme.on-background.with-alpha(0.1);
            border-radius: 8px;
            preferred-height: code-content.preferred-height;
            code-metrics := Text { visible: false; text: block.text; font-family: "Noto Sans Mono"; font-size: 14px; wrap: no-wrap; }
            line-metrics := Text { visible: false; text: "M"; font-family: "Noto Sans Mono"; font-size: 14px; }
            ContextMenuArea {
                Menu {
                    MenuItem { title: "Copiar mensagem"; activated => { root.copy(root.source-markdown); } }
                    MenuItem { title: "Selecionar texto"; activated => { root.selecting = true; } }
                    MenuItem { title: "Copiar código"; activated => { root.copy(block.text); } }
                }
            code-content := VerticalLayout {
                padding: 8px;
                spacing: 4px;
                ScrollView {
                    min-height: 0px;
                    preferred-height: line-metrics.preferred-height * block.code-lines + (code-metrics.preferred-width > self.width ? 12px : 0px);
                    max-height: self.preferred-height;
                    vertical-stretch: 0;
                    content-width: max(self.width, code-metrics.preferred-width);
                    code := MeasuredInput {
                        row-id: root.row-id;
                        width: max(parent.width, code-metrics.preferred-width);
                        height: line-metrics.preferred-height * block.code-lines;
                        text: block.text;
                        accessible-role: text; accessible-label: block.text;
                        read-only: true;
                        wrap: no-wrap;
                        font-family: "Noto Sans Mono";
                        font-size: 14px;
                        color: root.foreground;
                        selection-background-color: Theme.primary;
                        selection-foreground-color: Theme.on-primary;
                    }
                }
            }
            }
            if hover.has-hover: IconButton {
                x: parent.width - 32px; y: 8px;
                width: 24px; height: 24px; icon: MaterialIcons.content-copy; label: "Copiar código";
                clicked => { root.copy(block.text); }
            }
        }
        if block.kind == "table": ScrollView {
            height: table.preferred-height + 16px;
            content-width: max(self.width, block.columns * 180px);
            table := VerticalLayout {
                for row in block.cells.length / block.columns: HorizontalLayout {
                    spacing: 0px;
                    for column in block.columns: cell-box := Rectangle {
                        property <MdCell> cell: block.cells[row * block.columns + column];
                        width: 180px;
                        border-width: 1px;
                        border-color: Theme.outline-variant;
                        background: Theme.on-background.with-alpha(self.cell.header ? 0.06 : 0.02);
                        VerticalLayout {
                            padding: 8px;
                            if !root.selecting: MeasuredText {
                                row-id: root.row-id;
                                text: cell-box.cell.rich;
                                default-color: root.foreground;
                                default-font-size: 16px;
                                link-color: Theme.primary;
                                horizontal-alignment: cell-box.cell.alignment == 1 ? center : cell-box.cell.alignment == 2 ? right : left;
                                link-clicked(url) => { root.link-clicked(url); }
                            }
                            if root.selecting: MeasuredInput {
                                row-id: root.row-id;
                                text: cell-box.cell.text;
                                read-only: true;
                                wrap: word-wrap;
                                font-size: 16px;
                                color: root.foreground;
                                selection-background-color: Theme.primary;
                                selection-foreground-color: Theme.on-primary;
                            }
                        }
                    }
                }
            }
        }
    }
    }
            }
            actions := TouchArea {
                visible: hover.has-hover || self.has-hover;
                x: parent.width - 60px; y: -8px;
                width: 60px; height: 28px;
                HorizontalLayout {
                    spacing: 0px;
                    IconButton { width: 28px; height: 28px; icon: MaterialIcons.more-vert; label: "Ações da mensagem"; clicked => { message-focus.focus(); message-menu.show({x: root.width - 60px, y: 20px}); } }
                    IconButton { width: 28px; height: 28px; icon: MaterialIcons.content-copy; label: "Copiar mensagem"; clicked => { root.copy(root.source-markdown); message-focus.focus(); } }
                }
            }
        }
    }
}

export struct MdMessage { blocks: [MdBlock], source: string }
export component MarkdownDemo inherits Window {
    title: "Zaplaud Markdown";
    width: 1000px;
    height: 760px;
    background: Theme.background;
    in property <[MdMessage]> messages;
    callback link-clicked(string);
    callback copy(string);
    public function copy-text(text: string) {
        clipboard.text = text;
        clipboard.select-all();
        clipboard.copy();
    }
    clipboard := TextInput { width: 0px; height: 0px; opacity: 0; }
    VerticalLayout {
        HorizontalLayout {
            MdButton { text: "Claro / escuro"; clicked => { Theme.dark = !Theme.dark; } }
        }
        ListView {
            for message in root.messages: Rectangle {
                background: Theme.surface;
                VerticalLayout {
                    padding: 12px;
                    MarkdownView {
                        blocks: message.blocks;
                        source-markdown: message.source;
                        link-clicked(url) => { root.link-clicked(url); }
                        copy(text) => { root.copy(text); }
                    }
                }
            }
        }
    }
}
