import { ListView, ScrollView } from "std-widgets.slint";
import { Theme, AvatarColors } from "resources.slint";
import { MaterialIcons } from "material-icons.slint";

export component Divider inherits Rectangle { height: 1px; background: Theme.outline-variant; }
export component Pill inherits Rectangle {
    in property <string> text;
    in property <color> foreground: Theme.on-surface;
    in property <length> text-size: 16px;
    accessible-role: AccessibleRole.text; accessible-label: root.text;
    background: Theme.surface-container-high;
    border-radius: self.height / 2;
    min-height: 32px;
    min-width: label.preferred-width + 32px;
    label := Text { text: root.text; color: root.foreground; font-size: root.text-size; horizontal-alignment: center; vertical-alignment: center; }
}
export component Badge inherits Pill {
    background: Theme.primary; foreground: Theme.on-primary; text-size: 12px; min-height: 16px; min-width: 16px;
}
export component Avatar inherits Rectangle {
    in property <image> source;
    in property <string> initials;
    in property <color> fallback-color: AvatarColors.background-0;
    in property <image> brand;
    in property <color> brand-color: Theme.on-surface;
    in property <string> label: root.initials;
    accessible-role: image; accessible-label: root.label;
    width: 48px; height: 48px; border-radius: self.width / 2; background: root.fallback-color;
    Text { text: root.source.width == 0 ? root.initials : ""; color: AvatarColors.foreground; font-size: 16px; font-weight: 500; horizontal-alignment: center; vertical-alignment: center; }
    Rectangle { width: parent.width; height: parent.height; border-radius: self.width / 2; clip: true;
        Image { width: parent.width; height: parent.height; source: root.source; image-fit: contain; image-rendering: pixelated; }
    }
    if root.brand.width > 0 && root.width >= 32px: Rectangle {
        x: parent.width * 0.58; y: parent.height * 0.58; width: parent.width * 0.42; height: self.width;
        border-radius: self.width / 2; background: Theme.surface;
        Image { x: parent.width * 0.15; y: self.x; width: parent.width * 0.7; height: self.width; source: root.brand; colorize: root.brand-color; }
    }
    @children
}
export component TextButton inherits Rectangle {
    in property <string> text;
    in property <bool> enabled: true;
    in property <color> foreground: Theme.primary;
    in property <length> text-size: 14px;
    in property <length> horizontal-padding: 12px;
    in property <TextHorizontalAlignment> horizontal-alignment: center;
    in property <image> trailing-icon;
    callback clicked();
    preferred-height: 40px; vertical-stretch: 0;
    min-height: 40px; min-width: label.preferred-width + root.horizontal-padding * 2 + (root.trailing-icon.width > 0 ? 24px : 0px); border-radius: 20px;
    Rectangle {
        border-radius: root.border-radius;
        background: touch.pressed ? root.foreground.with-alpha(0.12) : touch.has-hover ? root.foreground.with-alpha(0.08) : transparent;
        border-width: button-keys.has-focus ? 2px : 0px; border-color: Theme.primary;
    }
    label := Text { x: root.horizontal-padding; y: 0px; width: parent.width - root.horizontal-padding * 2 - (root.trailing-icon.width > 0 ? 24px : 0px); height: parent.height; text: root.text; color: root.enabled ? root.foreground : Theme.on-surface.with-alpha(0.38); font-size: root.text-size; font-weight: 500; horizontal-alignment: root.horizontal-alignment; vertical-alignment: center; }
    if root.trailing-icon.width > 0: Image { x: parent.width - 30px; y: (parent.height - 18px) / 2; width: 18px; height: 18px; source: root.trailing-icon; colorize: root.foreground; }
    forward-focus: button-keys;
    button-keys := FocusScope {
        enabled: root.enabled;
        key-pressed(event) => { if event.text == " " || event.text == Key.Return { root.clicked(); return accept; } return reject; }
    }
    touch := TouchArea { enabled: root.enabled; clicked => { button-keys.focus(); root.clicked(); } }
    accessible-role: button; accessible-label: root.text; accessible-enabled: root.enabled;
    accessible-action-default => { if root.enabled { root.clicked(); } }
}
export component FilledButton inherits TextButton {
    background: root.enabled ? Theme.primary : Theme.on-surface.with-alpha(0.12); foreground: Theme.on-primary;
}
export component IconButton inherits Rectangle {
    in property <image> icon;
    in property <string> label;
    in property <bool> enabled: true;
    in property <color> foreground: Theme.on-surface-variant;
    callback clicked();
    width: 40px; height: 40px; border-radius: 20px;
    Rectangle {
        border-radius: root.border-radius;
        background: area.pressed ? root.foreground.with-alpha(0.12) : area.has-hover ? root.foreground.with-alpha(0.08) : transparent;
        border-width: icon-keys.has-focus ? 2px : 0px; border-color: Theme.primary;
    }
    Image { x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2; width: 24px; height: 24px; source: root.icon; colorize: root.enabled ? root.foreground : Theme.on-surface.with-alpha(0.38); }
    forward-focus: icon-keys;
    icon-keys := FocusScope {
        enabled: root.enabled;
        key-pressed(event) => { if event.text == " " || event.text == Key.Return { root.clicked(); return accept; } return reject; }
    }
    area := TouchArea { enabled: root.enabled; clicked => { icon-keys.focus(); root.clicked(); } }
    accessible-role: button; accessible-label: root.label; accessible-enabled: root.enabled;
    accessible-action-default => { if root.enabled { root.clicked(); } }
}
export component Fab inherits IconButton { width: 56px; height: 56px; border-radius: 16px; background: Theme.primary-container; foreground: Theme.on-primary-container; }
export component TextField inherits Rectangle {
    in-out property <string> text;
    in property <string> placeholder;
    in property <bool> multiline: false;
    in property <bool> password: false;
    in property <bool> enabled: true;
    in property <bool> outlined;
    in property <bool> autofocus;
    in property <int> max-lines: 0;
    in property <bool> sends-on-enter: false;
    in property <image> leading-icon;
    in property <image> trailing-icon;
    in property <string> trailing-label;
    callback trailing-clicked();
    init => { if root.autofocus { input.focus(); } }
    callback edited(string);
    callback accepted();
    min-height: 56px;
    preferred-height: root.multiline ? (root.max-lines > 0 ? min(max(56px, metrics.preferred-height + 32px), root.max-lines * 24px + 32px) : 100px) : 56px; vertical-stretch: 0;
    background: root.outlined ? transparent : Theme.surface-container-high;
    border-radius: root.outlined ? 4px : 28px;
    border-width: root.outlined ? (input.has-focus ? 2px : 1px) : 0px;
    border-color: input.has-focus ? Theme.primary : Theme.outline;
    forward-focus: input;
    // TextInput mede o viewport imposto; o texto sem altura imposta mede as linhas reais.
    metrics := Text { visible: false; width: input.width; text: root.multiline ? root.text : ""; font-size: 16px; wrap: word-wrap; }
    Text { x: input.x; y: 16px; width: input.width; height: parent.height - 32px; text: root.text == "" && (!root.outlined || !input.has-focus) ? root.placeholder : ""; color: Theme.on-surface-variant; font-size: 16px; }
    if root.outlined && (root.text != "" || input.has-focus): Rectangle {
        x: 12px; y: -8px; height: 16px; width: floating-label.preferred-width + 8px; background: Theme.background;
        floating-label := Text { text: root.placeholder; color: input.has-focus ? Theme.primary : Theme.on-surface-variant; font-size: 12px; horizontal-alignment: center; }
    }
    input := TextInput {
        x: root.leading-icon.width > 0 ? 52px : 16px; y: 16px; width: parent.width - self.x - (root.trailing-icon.width > 0 ? 56px : 16px); height: parent.height - 32px;
        text <=> root.text; enabled: root.enabled; single-line: !root.multiline;
        color: Theme.on-surface; font-size: 16px;
        selection-background-color: Theme.primary; selection-foreground-color: Theme.on-primary;
        input-type: root.password ? InputType.password : InputType.text;
        edited => { root.edited(self.text); } accepted => { root.accepted(); }
        key-pressed(event) => {
            if root.sends-on-enter && event.text == Key.Return && !event.modifiers.shift {
                root.accepted(); return accept;
            }
            return reject;
        }
        accessible-label: root.placeholder;
    }
    if root.leading-icon.width > 0: Image { x: 16px; y: (parent.height - 24px) / 2; width: 24px; height: 24px; source: root.leading-icon; colorize: Theme.on-surface-variant; }
    if root.trailing-icon.width > 0: IconButton { x: parent.width - 48px; y: (parent.height - 40px) / 2; icon: root.trailing-icon; label: root.trailing-label; enabled: root.enabled; clicked => { root.trailing-clicked(); } }
    @children
}
export component Switch inherits Rectangle {
    in-out property <bool> checked;
    in property <string> text;
    in property <bool> enabled: true;
    callback toggled();
    min-width: 52px + (root.text == "" ? 0px : switch-label.preferred-width + 16px);
    height: 48px;
    accessible-role: switch; accessible-label: root.text; accessible-enabled: root.enabled;
    accessible-checked: root.checked;
    accessible-action-default => { if root.enabled { root.checked = !root.checked; root.toggled(); } }
    opacity: root.enabled ? 1 : 0.38;
    forward-focus: switch-keys;
    switch-keys := FocusScope {
        enabled: root.enabled;
        key-pressed(event) => { if event.text == " " || event.text == Key.Return { root.checked = !root.checked; root.toggled(); return accept; } return reject; }
    }
    switch-label := Text { x: 0px; width: parent.width - 68px; text: root.text; color: Theme.on-surface; font-size: 16px; vertical-alignment: center; }
    Rectangle {
        x: parent.width - 52px; y: 8px; width: 52px; height: 32px;
        border-radius: 16px; background: root.checked ? Theme.primary : Theme.surface-container-highest;
        border-width: root.checked ? 0px : 2px; border-color: Theme.outline;
        Rectangle {
            x: root.checked ? 26px : 8px; y: root.checked ? 4px : 8px;
            width: root.checked ? 24px : 16px; height: self.width; border-radius: self.width / 2;
            background: root.checked ? Theme.on-primary : Theme.outline;
        }
    }
    Rectangle { x: parent.width - 56px; y: 4px; width: 60px; height: 40px; border-radius: 20px;
        border-width: switch-keys.has-focus ? 2px : 0px; border-color: Theme.primary;
        background: switch-touch.has-hover ? Theme.primary.with-alpha(0.08) : transparent;
    }
    switch-touch := TouchArea { enabled: root.enabled; clicked => { switch-keys.focus(); root.checked = !root.checked; root.toggled(); } }
}
export component RadioButton inherits Rectangle {
    in-out property <bool> checked;
    in property <string> text;
    in property <bool> enabled: true;
    in property <length> indicator-width: 40px;
    in property <length> label-spacing: 0px;
    callback toggled();
    min-width: root.indicator-width + root.label-spacing + radio-label.preferred-width; min-height: 40px;
    accessible-role: radio-button; accessible-label: root.text; accessible-checked: root.checked; accessible-enabled: root.enabled;
    accessible-action-default => { if root.enabled { root.checked = true; root.toggled(); } }
    opacity: root.enabled ? 1 : 0.38;
    forward-focus: radio-keys;
    radio-keys := FocusScope {
        enabled: root.enabled;
        key-pressed(event) => { if event.text == " " || event.text == Key.Return { root.checked = true; root.toggled(); return accept; } return reject; }
    }
    Rectangle { x: 0px; y: (parent.height - 40px) / 2; width: root.indicator-width; height: 40px; border-radius: 20px;
        background: radio-touch.has-hover ? Theme.primary.with-alpha(0.08) : transparent;
        border-width: radio-keys.has-focus ? 2px : 0px; border-color: Theme.primary;
        Rectangle { x: (parent.width - 20px) / 2; y: 10px; width: 20px; height: 20px; border-radius: 10px; border-width: 2px; border-color: root.checked ? Theme.primary : Theme.on-surface-variant;
            if root.checked: Rectangle { x: 5px; y: 5px; width: 10px; height: 10px; border-radius: 5px; background: Theme.primary; }
        }
    }
    radio-label := Text { x: root.indicator-width + root.label-spacing; width: parent.width - self.x; text: root.text; color: Theme.on-surface; font-size: 16px; vertical-alignment: center; }
    radio-touch := TouchArea { enabled: root.enabled; clicked => { radio-keys.focus(); root.checked = true; root.toggled(); } }
}
export component CheckBox inherits Rectangle {
    in-out property <bool> checked;
    in property <string> text;
    in property <string> description;
    in property <bool> enabled: true;
    callback toggled();
    min-width: 40px; min-height: max(40px, check-label.preferred-height + (root.description == "" ? 0px : check-description.preferred-height));
    accessible-role: checkbox; accessible-label: root.text; accessible-checked: root.checked; accessible-enabled: root.enabled;
    accessible-description: root.description;
    accessible-action-default => { if root.enabled { root.checked = !root.checked; root.toggled(); } }
    opacity: root.enabled ? 1 : 0.38;
    forward-focus: check-keys;
    check-keys := FocusScope {
        enabled: root.enabled;
        key-pressed(event) => { if event.text == " " || event.text == Key.Return { root.checked = !root.checked; root.toggled(); return accept; } return reject; }
    }
    Rectangle { x: 0px; y: (parent.height - 40px) / 2; width: 40px; height: 40px; border-radius: 20px;
        background: check-touch.has-hover ? Theme.primary.with-alpha(0.08) : transparent;
        border-width: check-keys.has-focus ? 2px : 0px; border-color: Theme.primary;
        Rectangle { x: 11px; y: 11px; width: 18px; height: 18px; border-radius: 2px; border-width: 2px; border-color: root.checked ? Theme.primary : Theme.on-surface-variant;
            background: root.checked ? Theme.primary : transparent;
            if root.checked: Path { x: 3px; y: 4px; width: 12px; height: 10px; viewbox-width: 12; viewbox-height: 10; commands: "M 1 5 L 4.5 8 L 11 1"; stroke: Theme.on-primary; stroke-width: 2px; }
        }
    }
    check-label := Text { x: 40px; y: (parent.height - self.preferred-height - (root.description == "" ? 0px : check-description.preferred-height)) / 2; width: parent.width - 40px; height: self.preferred-height; text: root.text; color: Theme.on-surface; font-size: 16px; wrap: word-wrap; }
    check-description := Text { x: 40px; y: check-label.y + check-label.height; width: parent.width - 40px; height: root.description == "" ? 0px : self.preferred-height; text: root.description; color: Theme.on-surface; font-size: 16px; wrap: word-wrap; }
    check-touch := TouchArea { enabled: root.enabled; clicked => { check-keys.focus(); root.checked = !root.checked; root.toggled(); } }
}
export component SegmentedControl inherits Rectangle {
    in property <[string]> labels;
    in-out property <int> selected;
    callback chosen(int);
    height: 40px; border-radius: 20px; border-width: 1px; border-color: Theme.outline; clip: true;
    HorizontalLayout { spacing: 0px;
        for label[index] in root.labels: TextButton {
            text: (root.selected == index ? "✓  " : "") + label; background: root.selected == index ? Theme.secondary-container : transparent;
            border-radius: 0px;
            border-top-left-radius: index == 0 ? 20px : 0px;
            border-bottom-left-radius: index == 0 ? 20px : 0px;
            border-top-right-radius: index == root.labels.length - 1 ? 20px : 0px;
            border-bottom-right-radius: index == root.labels.length - 1 ? 20px : 0px;
            border-width: 1px; border-color: Theme.outline;
            foreground: Theme.on-surface;
            clicked => { root.selected = index; root.chosen(index); }
        }
    }
}
export component Chip inherits TextButton {
    in property <bool> selected;
    border-radius: 8px; min-height: 32px; border-width: 1px; border-color: Theme.outline-variant;
    background: root.selected ? Theme.secondary-container : transparent; foreground: Theme.on-surface;
}
export component Banner inherits Rectangle {
    in property <string> text;
    in property <string> action;
    in property <string> severity: "info";
    callback activated();
    accessible-role: groupbox; accessible-label: root.text;
    min-height: max(34px, label.preferred-height + 16px); background: Theme.secondary-container; border-radius: 10px;
    HorizontalLayout { padding-left: 12px; padding-right: 12px; padding-top: 8px; padding-bottom: 8px; spacing: 8px;
        VerticalLayout { alignment: center; Image { width: 18px; height: 18px; source: MaterialIcons.info; colorize: Theme.on-secondary-container; } }
        label := Text { text: root.text; font-size: 12px; wrap: word-wrap; color: root.severity == "error" ? Theme.error : Theme.on-secondary-container; vertical-alignment: center; }
        if root.action != "": TextButton { text: root.action; clicked => { root.activated(); } }
    }
}
export component Menu inherits PopupWindow {
    Rectangle { background: Theme.surface-container; border-radius: 4px;
        VerticalLayout { padding: 8px; @children }
    }
}
export component Dialog inherits Rectangle {
    in property <string> title;
    in property <string> text;
    in property <string> confirm;
    in property <string> cancel;
    in property <length> dialog-width: min(560px, max(280px, max(title-metrics.preferred-width, text-metrics.preferred-width) + 48px));
    title-metrics := Text { visible: false; text: root.title; font-size: 24px; }
    text-metrics := Text { visible: false; text: root.text; font-size: 14px; }
    callback confirmed(); callback dismissed();
    background: Theme.scrim.with-alpha(0.32);
    accessible-role: groupbox; accessible-label: root.title;
    init => { dialog-keys.focus(); }
    forward-focus: dialog-keys;
    dialog-keys := FocusScope {
        key-released(event) => { if event.text == Key.Escape { root.dismissed(); return accept; } return reject; }
    TouchArea { clicked => { root.dismissed(); } }
    Rectangle {
        x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
        width: min(root.dialog-width, parent.width - 40px); height: layout.preferred-height;
        background: Theme.surface-container-high; border-radius: 28px;
        TouchArea {}
        layout := VerticalLayout { padding: 24px; spacing: 16px;
            Text { text: root.title; font-size: 24px; color: Theme.on-surface; wrap: word-wrap; }
            Text { text: root.text; font-size: 14px; color: Theme.on-surface-variant; wrap: word-wrap; }
            @children
            HorizontalLayout { Rectangle {} if root.cancel != "": TextButton { horizontal-stretch: 0; text: root.cancel; clicked => { root.dismissed(); } } if root.confirm != "": TextButton { horizontal-stretch: 0; text: root.confirm; clicked => { root.confirmed(); } } }
        }
    }
    }
}
export component Sheet inherits Rectangle {
    callback dismissed();
    in property <string> title;
    accessible-role: groupbox; accessible-label: root.title;
    background: Theme.scrim.with-alpha(0.32);
    init => { sheet-keys.focus(); }
    forward-focus: sheet-keys;
    sheet-keys := FocusScope {
        key-released(event) => { if event.text == Key.Escape { root.dismissed(); return accept; } return reject; }
    TouchArea { clicked => { root.dismissed(); } }
    Rectangle { x: max(0px, parent.width - 480px); width: min(480px, parent.width); height: parent.height;
        background: Theme.surface-container-low;
        TouchArea {}
        @children
    }
    }
}
export component ProgressRing inherits Rectangle {
    in property <string> label;
    width: 40px; height: 40px;
    accessible-role: progress-indicator; accessible-label: root.label;
    Path { width: parent.width; height: parent.height; viewbox-width: 40; viewbox-height: 40;
        commands: "M 20 3 A 17 17 0 1 1 3 20";
        stroke: Theme.primary; stroke-width: 4px;
    }
}
export component Tooltip inherits Rectangle {
    in property <string> text;
    callback clicked();
    area := TouchArea { clicked => { root.clicked(); } }
    @children
    if area.has-hover: Rectangle {
        y: -32px; height: 28px; width: label.preferred-width + 16px;
        background: Theme.on-surface; border-radius: 4px;
        label := Text { text: root.text; color: Theme.surface; font-size: 12px; horizontal-alignment: center; vertical-alignment: center; }
    }
}
export { ListView as ScrollList } from "std-widgets.slint";
export component ScrollContainer inherits ScrollView {}
