import { Theme, Icons } from "resources.slint";
import { Labels } from "labels.slint";
import { LoginPane, LoginState } from "login.slint";
import { ListPane, ListState } from "list.slint";
import { ConversationPane, ConversationState } from "conversation.slint";
import { Dialog } from "widgets/kit.slint";
export { Theme, Icons, AvatarColors } from "resources.slint";
export { Labels } from "labels.slint";
export { LoginState } from "login.slint";
export { ListState, SessionRow, ServerRow } from "list.slint";
export { ConversationState } from "conversation.slint";
export global AppEvents {
    callback settings();
    callback selection-changed(string);
    callback logout(string);
    callback theme(bool);
}
export global ShellState {
    in-out property <string> logout-origin;
    in property <string> logout-title;
    in property <string> logout-warning;
    in-out property <bool> logout-busy;
    in-out property <string> message;
    callback confirm-logout();
}
export component AppWindow inherits Window {
    title: Labels.app-name; icon: Icons.ic-zaplaud;
    width: 1100px; height: 760px; background: Theme.background;
    out property <bool> wide: root.width >= 840px;
    forward-focus: keys;
    keys := FocusScope {
        key-pressed(event) => {
            if root.wide && (event.modifiers.control || event.modifiers.meta) && (event.text == "f" || event.text == "F") && !LoginState.visible {
                ListState.search-open = true; return accept;
            }
            return reject;
        }
        key-released(event) => {
            if event.text == Key.Escape {
                if LoginState.confirm-http { LoginState.cancel-http(); }
                else if LoginState.visible && LoginState.can-cancel { LoginState.cancel(); }
                else if ConversationState.selected { ConversationState.close(); }
                else if ListState.search-open { ListState.query = ""; ListState.search-open = false; ListState.changed(); }
                return accept;
            }
            return reject;
        }
        if LoginState.visible: LoginPane {}
        if !LoginState.visible: HorizontalLayout {
            spacing: 0px;
            if root.wide || !ConversationState.selected: ListPane { width: root.wide ? 360px : parent.width; }
            if root.wide: Rectangle { width: 1px; background: Theme.outline-variant; }
            if root.wide || ConversationState.selected: ConversationPane { narrow: !root.wide; }
        }
    }
    if ShellState.logout-origin != "": Dialog {
        title: ShellState.logout-title; text: ShellState.logout-warning; confirm: Labels.confirm; cancel: Labels.cancel;
        confirmed => { if !ShellState.logout-busy { ShellState.logout-busy = true; ShellState.confirm-logout(); } }
        dismissed => { if !ShellState.logout-busy { ShellState.logout-origin = ""; } }
    }
    if ShellState.message != "": Dialog {
        text: ShellState.message; confirm: Labels.confirm;
        confirmed => { ShellState.message = ""; } dismissed => { ShellState.message = ""; }
    }
}
